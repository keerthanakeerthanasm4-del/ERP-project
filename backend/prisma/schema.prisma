generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
}
model Project {
  id          Int      @id @default(autoincrement())
  projectName String
  description String?
  status      String
  progress    Int      @default(0)
  createdAt   DateTime @default(now())
}