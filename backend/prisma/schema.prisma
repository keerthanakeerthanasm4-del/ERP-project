generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id      Int      @id @default(autoincrement())
  name         String
  usn          String?  @unique
  email        String   @unique
  passwordHash String
  ph_no        String?
  join_date    DateTime @default(now())
  dept_name    String?
}

model Project {
  project_id   String   @id
  project_name String
  description  String?
  start_date   DateTime?
  deadline     DateTime?
  status       String   @default("ACTIVE")
}