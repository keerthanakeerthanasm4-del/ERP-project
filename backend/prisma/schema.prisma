generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id      Int      @id @default(autoincrement())
  name         String
  usn          String?  @unique
  email        String   @unique
  passwordHash String   @map("password")
  ph_no        String?  @map("phone")
  join_date    DateTime @default(now())
  dept_name    String?
  projects     Project[] @relation("ProjectLead")
  memberships  ProjectMember[]
}

model Project {
  project_id   String   @id
  project_name String
  description  String?
  start_date   DateTime?
  deadline     DateTime?
  status       String   @default("ACTIVE")
  lead_user_id Int
  created_at   DateTime @default(now())
  lead         User     @relation("ProjectLead", fields: [lead_user_id], references: [user_id], onDelete: Cascade)
  members      ProjectMember[]
}

enum ProjectMemberRole {
  TEAM_LEAD
  TECH_LEAD
  TEAM_MEMBER
}

model ProjectMember {
  id         Int               @id @default(autoincrement())
  project_id String
  user_id    Int
  role       ProjectMemberRole
  added_at   DateTime          @default(now())
  project    Project           @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  user       User              @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([project_id, user_id])
}